TC WILL BE O(n) but SC WILL increase which means Space complexity
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int n = nums.size();

        // Boolean array of size n+1
        vector<bool> present(n + 1, false);

        // Mark all numbers that are present
        for (int num : nums) {
            present[num] = true;
        }

        // Find the number that was never marked
        for (int i = 0; i <= n; i++) {
            if (present[i] == false) {
                return i;
            }
        }

        return -1; // Never reached
    }
};
