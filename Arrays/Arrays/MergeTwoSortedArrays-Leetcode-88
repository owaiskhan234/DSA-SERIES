class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {
         n=nums1.size();
         m=nums2.size();
        vector<int>v3;
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                if(nums[i]==nums[j]
                {
                    v3.pushback(nums[i]);
                }
            }
        }
        return v3
    }
};
