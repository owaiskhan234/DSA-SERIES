#include<iostream>
#include<climits>
using namespace std;

int main()
{
    int n;
    cout << "Enter the value of n: ";
    cin >> n;

    int arr[n];

    cout << "Enter array elements: ";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    int largest = INT_MIN;
    int seclargest = INT_MIN;

    // Find largest
    for(int i = 0; i < n; i++)
    {
        if(arr[i] > largest)
        {
            largest = arr[i];
        }
    }

    cout << "The largest number is: " << largest << endl;

    // Find second largest
    for(int i = 0; i < n; i++)
    {
        if(arr[i] > seclargest && arr[i] != largest)
        {
            seclargest = arr[i];
        }
    }

    cout << "The second largest number is: " << seclargest;

    return 0;
}
