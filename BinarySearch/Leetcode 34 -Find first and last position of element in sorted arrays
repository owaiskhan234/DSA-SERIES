class Solution {
public:
    vector<int> searchRange(vector<int>& arr, int target) {
        int n = arr.size();
        vector<int> ans(2, -1);
        
        // 1. Find the starting position
        int lo = 0;
        int hi = n - 1;
        while(lo <= hi) {
            int mid = (lo + hi) / 2;
            if(arr[mid] > target) {
                hi = mid - 1;
            } else if(arr[mid] < target) {
                lo = mid + 1;
            } else {
                ans[0] = mid;
                hi = mid - 1; // Keep searching left
            }
        }    
   
        // 2. Find the ending position
        lo = 0;
        hi = n - 1;
        while(lo <= hi) {
            int mid = (lo + hi) / 2;
            if(arr[mid] > target) {
                hi = mid - 1;
            } else if(arr[mid] < target) {
                lo = mid + 1;
            } else {
                ans[1] = mid; // Fixed: Changed from ans[0] to ans[1]
                lo = mid + 1; // Keep searching right
            }
        }  
        
        return ans;   
    }
};
