class Solution {
public:
    int mySqrt(int x) {
        for(long long i=0;i<=x;i++)
        {
            if(i*i==x)
            {
                return i;
            }
            if(i*i>x)
            {
                return i-1;
            }
           
        }
         return 453434;
    }
};


///code with binary search and with O(log)n
class Solution {
public:
    int mySqrt(int n) {
        if(n==0)
        {
            return 0;
        }
        int low=1;
        int high=n;
        while(low<=high)
       {
          int mid=low+(high-low)/2;
          if(mid>n/mid)
          {
            high=mid-1;
          }
          else if(mid<n/mid)
          {
            low=mid+1;
          }
          else
          {
            return mid;
          }
         
       }
     return high;
}
};
