class Solution {
  public:
    int lowerBound(vector<int>& arr, int target) {
    int n=arr.size(); 
    int lo=0;
    int hi=n-1;
    int lb=n;
        while(lo<=hi)
        {
             int  mid=(lo+hi)/2;
            if(arr[mid]<target)
            {
                lo=mid+1;
            }
            else
            {
                lb=mid;
                hi=mid-1;
                
            }
        }
        return lb;
    }
};
