
class Solution {
public:
    bool isValid(string s) {
        if (s.size() % 2 != 0) return false;

        stack<char> st;

        for (char ele : s) {
            if (ele == '(' || ele == '{' || ele == '[') {
                st.push(ele);
            }
            else {
                if (st.size() == 0) return false;

                if ((ele == ')' && st.top() == '(') ||
                    (ele == '}' && st.top() == '{') ||
                    (ele == ']' && st.top() == '[')) {
                    st.pop();
                }
                else {
                    return false;
                }
            }
        }

        if (st.size() == 0) {
            return true;
        }
        else {
            return false;
        }
    }
};
