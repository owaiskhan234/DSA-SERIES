
class Solution {
public:
    int largestRectangleArea(vector<int>& arr) {
        int n = arr.size();
        vector<int> nsi(n, n);
        vector<int> psi(n, -1);
        stack<int> st;

        // Next Smaller Element
        for(int i = n - 1; i >= 0; i--) {
            while(st.size() > 0 && arr[st.top()] >= arr[i]) {
                st.pop();
            }

            if(st.size() > 0) {
                nsi[i] = st.top();
            }

            st.push(i);
        }

        while(st.size() > 0) {
            st.pop();
        }

        // Previous Smaller Element
        for(int i = 0; i < n; i++) {
            while(st.size() > 0 && arr[st.top()] >= arr[i]) {
                st.pop();
            }

            if(st.size() > 0) {
                psi[i] = st.top();
            }

            st.push(i);
        }

        int maxArea = 0;

        for(int i = 0; i < n; i++) {
            int height = arr[i];
            int width = nsi[i] - psi[i] - 1;
            int area = height * width;

            maxArea = max(maxArea, area);
        }

        return maxArea;
    }
};
